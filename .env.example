# .env.example - Example environment variables for shelfmark (fork v1.4.0 + Telegram + IT)

# Web port
FLASK_PORT=8084

# Container user/group (for non-root mode)
PUID=1000
PGID=1000

# Debug mode
DEBUG=false

# OIDC auto-redirect
OIDC_AUTO_REDIRECT=false

# Book download directory
BOOKS_PATH=./books

# Application config directory (persists users.db, telegram_session*, telegram_cache.json, assets/)
CONFIG_PATH=./config

# Temp directory for SeleniumBase
TMP_PATH=/tmp/shelfmark

# Log directory
LOG_PATH=/var/log/shelfmark

# Enable Tor routing
USING_TOR=false

# Enable WireGuard VPN
USING_WIREGUARD=false

# Disable IPv6 leak check
WIREGUARD_DISABLE_IPV6=true

# Custom domain (for reverse proxy)
# DOMAIN=localhost

# --- Upstream v1.4.0 features (opt-in, see docs/environment-variables.md) ---
# Static read-only API key (admin per-request, use X-Api-Key behind proxies)
# SHELFMARK_API_KEY=
# TorBox torrent client: PROWLARR_TORRENT_CLIENT=torbox + key
# PROWLARR_TORRENT_CLIENT=
# TORBOX_API_KEY=
# Libgen direct catalogue source
# LIBGEN_SEARCH_ENABLED=false
# Calibre library check (also mount /path/to/calibre-library:/calibre-library:ro)
# LIBRARY_CHECK_CALIBRE_ENABLED=false
# CALIBRE_LIBRARY_DB_PATH=/calibre-library/metadata.db
# MyAnonamouse enrichment for Prowlarr
# PROWLARR_MAM_ID=
# Default role for auto-provisioned proxy users (first account ever is still admin)
# PROXY_AUTH_DEFAULT_ROLE=user
# Default search content type: ebook|audiobook
# DEFAULT_CONTENT_TYPE=ebook
# External Blackhole downloader directory (must match inside/outside container)
# BLACKHOLE_DIRECTORY=